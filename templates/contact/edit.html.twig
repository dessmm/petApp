{% extends 'base.html.twig' %}

{% block title %}Edit Message – LuxePaws{% endblock %}

{% block content %}
<style>
  .fade-section {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease-out;
  }
  .fade-in {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<section class="max-w-5xl mx-auto px-6 py-12 fade-section">
  <div class="text-center mb-10">
    <h1 class="text-4xl font-bold text-[var(--navy)] mb-3">Edit <span class="text-[var(--gold)]">Message</span></h1>
    <p class="text-gray-600 text-lg">Update the customer’s inquiry details below.</p>
  </div>

  <div class="bg-[var(--cream)] p-8 rounded-3xl shadow-lg">
    {{ include('contact/_form.html.twig', {
      'button_label': 'Update Message',
      'button_classes': 'w-full py-3 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition'
    }) }}

    <div class="mt-10 flex justify-between items-center border-t border-[var(--gold)] pt-6">
      <a href="{{ path('app_contact_index') }}"
         class="flex items-center text-[var(--navy)] font-medium hover:text-[var(--gold)] transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Messages
      </a>

      {{ include('contact/_delete_form.html.twig', {
        'contact': contact
      }) }}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fadeSection = document.querySelector('.fade-section');
    if (fadeSection) fadeSection.classList.add('fade-in');
  });
</script>
{% endblock %}
