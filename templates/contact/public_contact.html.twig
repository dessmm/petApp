{% extends 'base.html.twig' %}

{% block title %}Contact Us – LuxePaws{% endblock %}

{% block content %}
<style>
  .fade-section {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease-out;
  }
  .fade-in {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<section class="max-w-6xl mx-auto mt-10 mb-20 px-6">
  <div class="text-center mb-14 fade-section">
    <h1 class="text-4xl font-bold text-[var(--navy)] mb-4">
      Get in Touch with <span class="text-[var(--gold)]">LuxePaws</span>
    </h1>
    <p class="text-gray-600 max-w-2xl mx-auto text-[16px] leading-relaxed">
      Have a question, feedback, or need grooming assistance?  
      Our team would love to hear from you.  
      Send us a message and we’ll respond as soon as possible.
    </p>
  </div>

  {% for message in app.flashes('success') %}
    <div class="mb-6 bg-green-100 text-green-800 px-4 py-3 rounded-lg text-center fade-section">
      {{ message }}
    </div>
  {% endfor %}

  <section class="grid md:grid-cols-2 gap-10 items-start fade-section">
    <div class="bg-[var(--cream)] p-8 rounded-2xl shadow-md hover:shadow-lg transition">
      <h2 class="text-2xl font-semibold text-[var(--navy)] mb-4">Send Us a Message</h2>
      {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            {{ form_label(form.firstName, 'First Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.firstName, {'attr': {'class': 'w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--gold)] outline-none'}}) }}
            {{ form_errors(form.firstName) }}
          </div>
          <div>
            {{ form_label(form.lastName, 'Last Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.lastName, {'attr': {'class': 'w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--gold)] outline-none'}}) }}
            {{ form_errors(form.lastName) }}
          </div>
        </div>

        <div>
          {{ form_label(form.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.email, {'attr': {'class': 'w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--gold)] outline-none'}}) }}
          {{ form_errors(form.email) }}
        </div>

        <div>
          {{ form_label(form.phone, 'Phone', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.phone, {'attr': {'class': 'w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--gold)] outline-none', 'placeholder': '09123456789 or +639123456789'}}) }}
          {{ form_errors(form.phone) }}
        </div>

        <div>
          {{ form_label(form.subject, 'Subject', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.subject, {'attr': {'class': 'w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--gold)] outline-none'}}) }}
          {{ form_errors(form.subject) }}
        </div>

        <div>
          {{ form_label(form.message, 'Message', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.message, {'attr': {'class': 'w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[var(--gold)] outline-none', 'rows': 5}}) }}
          {{ form_errors(form.message) }}
        </div>

        <div class="text-center">
          <button type="submit"
            class="w-full py-3 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
            Send Message
          </button>
        </div>
      {{ form_end(form) }}
    </div>

    <div class="text-gray-700 space-y-4 fade-section">
      <h2 class="text-2xl font-semibold text-[var(--navy)] mb-2">Contact Information</h2>
      <p><span class="font-medium text-[var(--gold)]">📍 Address:</span> 123 Pet Street, Dumaguete City, Philippines</p>
      <p><span class="font-medium text-[var(--gold)]">📞 Phone:</span> +63 912 345 6789</p>
      <p><span class="font-medium text-[var(--gold)]">✉️ Email:</span> support@luxepaws.com</p>

      <div class="mt-6">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d31498.826589629596!2d123.26179459878476!3d9.301927506847678!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x33ab6edb788ea0f7%3A0xd79dfe9b5bfc37fb!2sDumaguete%20City%2C%20Negros%20Oriental!5e0!3m2!1sen!2sph!4v1760508200037!5m2!1sen!2sph"
           width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">"
          class="rounded-xl shadow-md"></iframe>
      </div>
    </div>
  </section>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fadeSections = document.querySelectorAll('.fade-section');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('fade-in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    fadeSections.forEach(section => observer.observe(section));
  });
</script>
{% endblock %}
