{% extends 'base.html.twig' %}

{% block title %}Features – LuxePaws{% endblock %}

{% block content %}

<style>
  .fade-section {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease-out;
  }
  .fade-in {
    opacity: 1;
    transform: translateY(0);
  }

  .feature-card {
    background-color: rgba(240, 236, 227, 0.9); 
    transition: all 0.3s ease;
  }
  .feature-card:hover {
    background-color: rgba(230, 225, 215, 1);
    transform: translateY(-4px);
  }
</style>

<section class="text-center mb-14 fade-section">
  <h1 class="text-4xl font-bold text-[var(--navy)] mb-4">Powerful Features for Every Pet Owner</h1>
  <p class="text-gray-600 max-w-2xl mx-auto text-[16px] leading-relaxed">
    LuxePaws offers smart and seamless tools that make pet grooming appointments simple, organized, 
    and stress-free — for both pet owners and groomers alike.
  </p>
</section>

<div class="grid md:grid-cols-3 gap-8 fade-section">
  <div class="feature-card p-8 rounded-2xl shadow hover:shadow-lg">
    <div class="text-[var(--gold)] text-3xl mb-2">📅</div>
    <h3 class="text-xl font-semibold text-[var(--navy)] mb-2">Online Booking</h3>
    <p class="text-gray-700 text-sm leading-relaxed">
      Schedule grooming sessions anytime, anywhere — no phone calls or waiting required.
    </p>
  </div>

  <div class="feature-card p-8 rounded-2xl shadow hover:shadow-lg">
    <div class="text-[var(--gold)] text-3xl mb-2">💈</div>
    <h3 class="text-xl font-semibold text-[var(--navy)] mb-2">Service Listings</h3>
    <p class="text-gray-700 text-sm leading-relaxed">
      Explore grooming options with transparent pricing and detailed descriptions for each service.
    </p>
  </div>

  <div class="feature-card p-8 rounded-2xl shadow hover:shadow-lg">
    <div class="text-[var(--gold)] text-3xl mb-2">⏰</div>
    <h3 class="text-xl font-semibold text-[var(--navy)] mb-2">Appointment Tracking</h3>
    <p class="text-gray-700 text-sm leading-relaxed">
      Stay on top of your upcoming and completed appointments with an easy-to-use dashboard.
    </p>
  </div>

  <div class="feature-card p-8 rounded-2xl shadow hover:shadow-lg">
    <div class="text-[var(--gold)] text-3xl mb-2">🔔</div>
    <h3 class="text-xl font-semibold text-[var(--navy)] mb-2">Smart Notifications</h3>
    <p class="text-gray-700 text-sm leading-relaxed">
      Get instant updates for appointment confirmations, reminders, and reschedules.
    </p>
  </div>

  <div class="feature-card p-8 rounded-2xl shadow hover:shadow-lg">
    <div class="text-[var(--gold)] text-3xl mb-2">🐾</div>
    <h3 class="text-xl font-semibold text-[var(--navy)] mb-2">Pet & Owner Profiles</h3>
    <p class="text-gray-700 text-sm leading-relaxed">
      Keep track of your pet’s grooming history, preferences, and details — all in one place.
    </p>
  </div>

  <div class="feature-card p-8 rounded-2xl shadow hover:shadow-lg">
    <div class="text-[var(--gold)] text-3xl mb-2">⭐</div>
    <h3 class="text-xl font-semibold text-[var(--navy)] mb-2">Ratings & Feedback</h3>
    <p class="text-gray-700 text-sm leading-relaxed">
      Share your experience and help us improve our services for every pet lover out there.
    </p>
  </div>
</div>

<section class="mt-16 text-center fade-section">
  <h2 class="text-2xl font-bold text-[var(--navy)] mb-3">More Than Just Grooming</h2>
  <p class="text-gray-600 max-w-xl mx-auto text-[15px] leading-relaxed">
    LuxePaws is built to make your pet’s grooming experience easy, personalized, and reliable.
    Enjoy peace of mind knowing that your furry friend is always cared for by trusted professionals.
  </p>
  <a href="{{ path('app_appointment_new') }}"
     class="inline-block mt-6 px-6 py-2.5 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
    Try LuxePaws Today →
  </a>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fadeSections = document.querySelectorAll('.fade-section');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('fade-in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    fadeSections.forEach(section => observer.observe(section));
  });
</script>

{% endblock %}
