{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}My Account – Admin{% endblock %}

{% block styles %}
<style>
  header, footer { display: none !important; }
  .card { background: #fff; border: 1px solid #e5e7eb; padding: 1.25rem; border-radius: 0.75rem; }
</style>
{% endblock %}

{% block content %}
<section class="p-6 bg-white rounded-2xl shadow-lg border border-gray-200">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-3xl font-bold text-[var(--navy)]">My Account</h1>
      <p class="text-sm text-gray-600">Manage your admin account.</p>
    </div>
    {# Top change-password link removed as a duplicate; use action button in header instead. #}
  </div>

  <div class="card">
    <div class="md:flex md:items-center md:justify-between">
      <div class="md:flex md:items-center md:gap-6">
        <div class="flex-shrink-0">
          <div class="w-28 h-28 rounded-full bg-[var(--navy)] flex items-center justify-center text-white text-2xl font-bold">
            {% set initials = (user.fullName ?: user.username)[:2] %}
            {{ initials|upper }}
          </div>
        </div>

        <div class="mt-4 md:mt-0">
          <h2 class="text-xl font-bold text-[var(--navy)]">{{ user.fullName ?: user.username }}</h2>
          <p class="text-sm text-gray-600">{{ user.email ?: '-' }}</p>
          <p class="mt-2 text-xs text-gray-500">Username: <span class="font-medium text-[var(--navy)]">{{ user.username }}</span></p>
          <p class="mt-1 text-xs text-gray-500">Role:
            {% set roles = user.roles %}
            {% if roles is iterable and roles|length > 0 %}
              {% if 'ROLE_ADMIN' in roles %}
                <span class="text-red-600 font-semibold">Admin</span>
              {% else %}
                <span class="text-gray-700">{{ roles|first }}</span>
              {% endif %}
            {% else %}
              <span class="text-gray-400">-</span>
            {% endif %}
          </p>
        </div>
      </div>

      <div class="mt-4 md:mt-0 flex items-center space-x-3">
        <a href="{{ path('app_admin_account_change_password') }}" class="px-4 py-2 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow">Change Password</a>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 bg-gray-50 rounded-lg">
        <p class="text-xs text-gray-500">Created</p>
        <p class="font-medium text-[var(--navy)]">{{ user.createdAt ? user.createdAt|date('M d, Y') : '-' }}</p>
      </div>
      <div class="p-4 bg-gray-50 rounded-lg">
        <p class="text-xs text-gray-500">Status</p>
        <p class="font-medium">
          {% if user.archivedAt is not null %}
            <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">Archived</span>
          {% elseif user.isActive %}
            <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-sm">Active</span>
          {% else %}
            <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-sm">Inactive</span>
          {% endif %}
        </p>
      </div>
    </div>
  </div>
</section>
{% endblock %}
