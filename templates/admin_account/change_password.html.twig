{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}Change Password – Admin{% endblock %}

{% block styles %}
<style>
    header, footer { display: none !important; }
    .layout { display: flex; gap: 1.5rem; align-items: flex-start; }
    .flex-1 { flex: 1; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.25rem; box-shadow: 0 6px 18px rgba(15,23,42,0.06); }
    .form-card { background: #fff; border: 1px solid #e5e7eb; padding: 1.25rem; border-radius: 0.75rem; }
</style>
{% endblock %}

{% block content %}
<div class="layout">
    {# Admin dashboard may not have a staff sidebar; keep layout for consistency #}
    <div class="flex-1">
        <section class="card">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-[var(--navy)]">Change Password</h1>
              <p class="text-sm text-gray-600">Update your admin password. Choose a strong password.</p>
            </div>

            <a href="{{ path('app_admin_account_profile') }}"
               class="px-3 py-2 bg-gray-100 text-[var(--navy)] font-semibold rounded-lg hover:bg-gray-200 transition text-sm">
              Back
            </a>
          </div>

          <div class="form-card">
            {{ form_start(form, {'attr': {'id': 'changePasswordForm', 'class': 'space-y-6'}}) }}
              <div class="mb-4">
                {{ form_label(form.currentPassword, 'Current password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.currentPassword, {'attr': {'class': 'mt-1 block w-full rounded-lg border-gray-300 shadow-sm p-2', 'placeholder': 'Enter current password', 'autocomplete': 'current-password'}}) }}
                {{ form_errors(form.currentPassword) }}
              </div>

              <div class="mb-4">
                {{ form_label(form.newPassword.first, 'New password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.newPassword.first, {'attr': {'class': 'mt-1 block w-full rounded-lg border-gray-300 shadow-sm p-2', 'placeholder': 'Choose a new password', 'autocomplete': 'new-password', 'id': 'adminNewPassword1'}}) }}
                <p class="text-xs text-gray-500 mt-2">Use at least 8 characters, mix letters and numbers for strength.</p>
                <div class="mt-2">
                  <div id="adminPwStrengthBar" class="h-2 bg-gray-200 rounded overflow-hidden">
                    <div id="adminPwStrengthFill" class="h-full bg-red-500" style="width:0%"></div>
                  </div>
                  <p id="adminPwStrengthText" class="text-xs text-gray-600 mt-1">Strength: <span class="font-semibold">Very weak</span></p>
                </div>
                {{ form_errors(form.newPassword.first) }}
              </div>

              <div class="mb-4">
                {{ form_label(form.newPassword.second, 'Confirm new password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.newPassword.second, {'attr': {'class': 'mt-1 block w-full rounded-lg border-gray-300 shadow-sm p-2', 'placeholder': 'Repeat new password', 'autocomplete': 'new-password', 'id': 'adminNewPassword2'}}) }}
                {{ form_errors(form.newPassword.second) }}
              </div>

              <div class="mt-4">
                <button type="submit" class="px-4 py-2 rounded bg-[var(--gold)] text-[var(--navy)] font-semibold">Update Password</button>
                <a href="{{ path('app_admin_account_profile') }}" class="ml-3 text-sm text-gray-600">Cancel</a>
              </div>
            {{ form_end(form) }}
          </div>
        </section>
    </div>
</div>
{% endblock %}

{% block scripts %}
  {{ parent() }}
  <script>
    (function(){
      function addToggle(inputId){
        const input = document.getElementById(inputId);
        if(!input) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'relative';
        input.parentNode.insertBefore(wrapper, input);
        wrapper.appendChild(input);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'absolute right-2 top-2 text-sm text-gray-600';
        btn.innerText = 'Show';
        btn.addEventListener('click', function(){
          if(input.type === 'password'){ input.type = 'text'; btn.innerText = 'Hide'; }
          else { input.type = 'password'; btn.innerText = 'Show'; }
        });
        wrapper.appendChild(btn);
      }

      addToggle('adminNewPassword1');
      addToggle('adminNewPassword2');
      addToggle(document.querySelector('input[name$="[currentPassword]"]')?.id || '');

      const pwInput = document.getElementById('adminNewPassword1');
      const fill = document.getElementById('adminPwStrengthFill');
      const text = document.getElementById('adminPwStrengthText');
      if(pwInput && fill && text){
        pwInput.addEventListener('input', function(){
          const v = pwInput.value || '';
          let score = 0;
          if(v.length >= 8) score += 1;
          if(/[A-Z]/.test(v)) score += 1;
          if(/[0-9]/.test(v)) score += 1;
          if(/[^A-Za-z0-9]/.test(v)) score += 1;
          const percent = Math.min(100, (score / 4) * 100);
          fill.style.width = percent + '%';
          if(score <= 1){ fill.className = 'h-full bg-red-500'; text.querySelector('span').innerText = 'Very weak'; }
          else if(score === 2){ fill.className = 'h-full bg-yellow-400'; text.querySelector('span').innerText = 'Weak'; }
          else if(score === 3){ fill.className = 'h-full bg-green-400'; text.querySelector('span').innerText = 'Good'; }
          else { fill.className = 'h-full bg-green-600'; text.querySelector('span').innerText = 'Strong'; }
        });
      }
    })();
  </script>
{% endblock %}
