{# templates/appointment/_delete_form.html.twig #}
{# Accept either appointment OR id (fallback) #}
{% set appointmentId = appointment is defined ? appointment.id : (id is defined ? id : null) %}

{% if appointmentId %}
  <form method="post"
        action="{{ path('app_appointment_delete', {'id': appointmentId}) }}"
        onsubmit="return confirm('Are you sure you want to delete this appointment?');"
        class="inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointmentId) }}">
    <button class="text-red-600 hover:underline">Delete</button>
  </form>
{% else %}
{% endif %}
