<form method="post" action="{{ path('app_admin_appointments_delete', {'id': appointment.id}) }}" onsubmit="return confirm('Are you sure you want to delete this appointment?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
    <button class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
        Delete
    </button>
</form>
