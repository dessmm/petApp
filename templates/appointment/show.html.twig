{% extends 'base.html.twig' %}

{% block title %}Appointment Details{% endblock %}

{% block content %}
  <h2 class="text-2xl font-semibold mb-6">Appointment Details</h2>

  <div class="bg-white p-6 shadow rounded-lg space-y-4">
    <div>
      <span class="text-gray-500 text-sm">Pet Name</span>
      <p class="text-lg font-medium text-gray-900">{{ appointment.petName }}</p>
    </div>

    <div>
      <span class="text-gray-500 text-sm">Owner</span>
      <p class="text-lg font-medium text-gray-900">{{ appointment.ownerName }}</p>
      <p class="text-sm text-gray-600">{{ appointment.ownerEmail }}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <span class="text-gray-500 text-sm">Date</span>
        <p class="text-lg font-medium text-gray-900">{{ appointment.appointmentDate ? appointment.appointmentDate|date('M d, Y') : '' }}</p>
      </div>
      <div>
        <span class="text-gray-500 text-sm">Time</span>
        <p class="text-lg font-medium text-gray-900">{{ appointment.appointmentTime ? appointment.appointmentTime|date('H:i') : '' }}</p>
      </div>
    </div>

    <div>
      <span class="text-gray-500 text-sm">Service</span>
      <p class="text-lg font-medium text-gray-900">{{ appointment.service }}</p>
    </div>
  </div>

  <div class="mt-6 flex space-x-3">
    <a href="{{ path('app_appointment_index') }}" 
       class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
      Back to list
    </a>
    <a href="{{ path('app_appointment_edit', {'id': appointment.id}) }}" 
       class="px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition">
      Edit
    </a>
    <form method="post" action="{{ path('app_appointment_delete', {'id': appointment.id}) }}" 
          onsubmit="return confirm('Are you sure you want to delete this appointment?');" 
          class="inline-block">
      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
      <button class="px-4 py-2 bg-red-600 text-white rounded-lg shadow hover:bg-red-700 transition">
        Delete
      </button>
    </form>
  </div>
{% endblock %}
