{% extends 'base.html.twig' %}

{% block title %}Register – LuxePaws{% endblock %}

{% block styles %}
<style>
  header, footer {
    display: none !important;
  }
</style>
{% endblock %}

{% block content %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 p-6">

  <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-gray-200 p-10">

    <div class="text-center mb-8">
      <i class="fa-solid fa-paw text-[var(--gold)] text-5xl mb-3"></i>
      <h1 class="text-3xl font-extrabold text-[var(--navy)]">Create Your Account</h1>
      <p class="text-gray-600 text-sm">Join LuxePaws and get started today.</p>
    </div>

    {{ form_start(registrationForm, { attr: { class: 'space-y-6' } }) }}

      <!-- Username -->
      <div>
        <label class="block text-sm font-semibold text-[var(--navy)] mb-1">
          Username
        </label>
        {{ form_widget(registrationForm.username, {
          attr: {
            class: 'w-full px-4 py-3 bg-gray-100 border border-gray-300 rounded-lg 
                    focus:ring-[var(--gold)] focus:border-[var(--gold)] transition'
          }
        }) }}
        {{ form_errors(registrationForm.username) }}
      </div>

      <!-- Email -->
      <div>
        <label class="block text-sm font-semibold text-[var(--navy)] mb-1">
          Email
        </label>
        {{ form_widget(registrationForm.email, {
          attr: {
            class: 'w-full px-4 py-3 bg-gray-100 border border-gray-300 rounded-lg 
                    focus:ring-[var(--gold)] focus:border-[var(--gold)] transition'
          }
        }) }}
        {{ form_errors(registrationForm.email) }}
      </div>

      <!-- Full name -->
      <div>
        <label class="block text-sm font-semibold text-[var(--navy)] mb-1">
          Full name
        </label>
        {{ form_widget(registrationForm.fullName, {
          attr: {
            class: 'w-full px-4 py-3 bg-gray-100 border border-gray-300 rounded-lg 
                    focus:ring-[var(--gold)] focus:border-[var(--gold)] transition'
          }
        }) }}
        {{ form_errors(registrationForm.fullName) }}
      </div>

      <!-- Password -->
      <div>
        <label class="block text-sm font-semibold text-[var(--navy)] mb-1">
          Password
        </label>
        {{ form_widget(registrationForm.plainPassword, {
          attr: {
            class: 'w-full px-4 py-3 bg-gray-100 border border-gray-300 rounded-lg 
                    focus:ring-[var(--gold)] focus:border-[var(--gold)] transition'
          }
        }) }}
        {{ form_errors(registrationForm.plainPassword) }}
      </div>

      <!-- Agree Terms -->
      <div class="flex items-start space-x-3">
        {{ form_widget(registrationForm.agreeTerms, {
          attr: { class: 'w-5 h-5 text-[var(--gold)] rounded focus:ring-[var(--gold)]' }
        }) }}
        <label class="text-sm text-gray-600">
          I agree to the LuxePaws <span class="text-[var(--gold)] font-semibold">Terms & Conditions</span>.
        </label>
        {{ form_errors(registrationForm.agreeTerms) }}
      </div>

      <!-- Register Button -->
      <button type="submit"
              class="w-full py-3 bg-[var(--gold)] text-[var(--navy)] font-bold rounded-lg 
                     shadow-md hover:bg-yellow-400 hover:shadow-lg transition duration-200">
        Create Account
      </button>

    {{ form_end(registrationForm) }}

    <!-- Back to login -->
    <p class="text-center text-gray-600 text-sm mt-6">
      Already have an account?
      <a href="{{ path('app_login') }}" class="text-[var(--gold)] font-semibold hover:underline">
        Sign in here
      </a>
    </p>

  </div>

</div>
{% endblock %}
