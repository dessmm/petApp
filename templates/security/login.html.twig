{% extends 'base.html.twig' %}

{% block title %}Login – LuxePaws{% endblock %}

{% block styles %}
<style>
  header, footer {
    display: none !important;
  }
</style>
{% endblock %}

{% block content %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 p-6">

  <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-gray-200 p-10">

    <div class="text-center mb-8">
      <i class="fa-solid fa-paw text-[var(--gold)] text-5xl mb-3"></i>
      <h1 class="text-3xl font-extrabold text-[var(--navy)]">Welcome Back</h1>
      <p class="text-gray-600 text-sm">Sign in to manage LuxePaws</p>
    </div>

    {% if error %}
      <div class="mb-6 p-3 rounded-lg bg-red-100 text-red-700 text-sm border border-red-300">
        {{ error.messageKey|trans(error.messageData, 'security') }}
      </div>
    {% endif %}

    <form method="post" class="space-y-6">

      <div>
        <label for="inputUsername" class="block text-sm font-semibold text-[var(--navy)] mb-1">
          Username
        </label>
        <input type="text" id="inputUsername" name="username" value="{{ last_username }}" required autofocus
               class="w-full px-4 py-3 bg-gray-100 border border-gray-300 rounded-lg 
                      focus:ring-[var(--gold)] focus:border-[var(--gold)] transition">
      </div>

      <div>
        <label for="inputPassword" class="block text-sm font-semibold text-[var(--navy)] mb-1">
          Password
        </label>
        <input type="password" id="inputPassword" name="password" required
               class="w-full px-4 py-3 bg-gray-100 border border-gray-300 rounded-lg
                      focus:ring-[var(--gold)] focus:border-[var(--gold)] transition">
      </div>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

      <button type="submit"
              class="w-full py-3 bg-[var(--gold)] text-[var(--navy)] font-bold rounded-lg 
                     shadow-md hover:bg-yellow-400 hover:shadow-lg transition duration-200">
        Sign In
      </button>

    </form>


    <p class="text-center text-gray-600 text-sm mt-4">
      Don’t have an account yet?
      <a href="{{ path('app_register') }}" 
         class="text-[var(--gold)] font-semibold hover:underline">
        Create one
      </a>
    </p>

  </div>

</div>
{% endblock %}
