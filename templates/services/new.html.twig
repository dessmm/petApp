{% extends 'base.html.twig' %}

{% block title %}Add Service – LuxePaws{% endblock %}

{% block content %}
<section class="max-w-3xl mx-auto px-4 py-12">
  <div class="bg-white p-8 rounded-2xl shadow-md border border-gray-100">
    <h1 class="text-2xl font-bold text-[var(--navy)] mb-4">Create New Service</h1>

    {{ form_start(form, { 'attr': { 'class': 'space-y-4' } }) }}

      <div>
        {{ form_label(form.name) }}
        {{ form_widget(form.name, { 'attr': { 'class': 'w-full p-3 border rounded' } }) }}
        {{ form_errors(form.name) }}
      </div>

      <div>
        {{ form_label(form.description) }}
        {{ form_widget(form.description, { 'attr': { 'class': 'w-full p-3 border rounded', 'rows': 4 } }) }}
        {{ form_errors(form.description) }}
      </div>

      <div>
        {{ form_label(form.price) }}
        {{ form_widget(form.price, { 'attr': { 'class': 'w-full p-3 border rounded' } }) }}
        {{ form_errors(form.price) }}
      </div>

      <div class="pt-4">
        <button type="submit" class="px-6 py-2 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded">Create Service</button>
        <a href="{{ path('app_services_index') }}" class="ml-3 text-sm text-gray-600">Cancel</a>
      </div>

    {{ form_end(form) }}
  </div>
</section>
{% endblock %}
