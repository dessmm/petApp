{% extends 'base.html.twig' %}

{% block title %}{{ app.request.attributes.get('_route') == 'app_product_new' ? 'New Product' : 'Edit Product' }}{% endblock %}

{% block content %}
<h2 class="text-2xl font-semibold mb-6">
  {{ app.request.attributes.get('_route') == 'app_product_new' ? 'Create Product' : 'Edit Product' }}
</h2>

<div class="bg-white p-6 shadow rounded-lg">
  {{ form_start(form, { 'attr': { 'class': 'space-y-5' } }) }}
    <div>
      {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
      {{ form_widget(form.name, {'attr': {'class': 'mt-1 block w-full border-gray-300 rounded-md shadow-sm p-2'}}) }}
    </div>

    <div>
      {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
      {{ form_widget(form.description, {'attr': {'class': 'mt-1 block w-full border-gray-300 rounded-md shadow-sm p-2'}}) }}
    </div>

    <div>
      {{ form_label(form.price, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
      {{ form_widget(form.price, {'attr': {'class': 'mt-1 block w-full border-gray-300 rounded-md shadow-sm p-2'}}) }}
    </div>

    <div class="flex space-x-4">
      <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700">Save</button>
      <a href="{{ path('app_product_index') }}" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">Cancel</a>
    </div>
  {{ form_end(form) }}
</div>
{% endblock %}
