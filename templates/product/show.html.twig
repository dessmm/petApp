{% extends 'base.html.twig' %}

{% block title %}Product {{ product.id }}{% endblock %}

{% block content %}
<h2 class="text-2xl font-semibold mb-6">Product Details</h2>

<div class="bg-white p-6 shadow rounded-lg space-y-4">
  <p><span class="font-semibold">ID:</span> {{ product.id }}</p>
  <p><span class="font-semibold">Name:</span> {{ product.name }}</p>
  <p><span class="font-semibold">Description:</span> {{ product.description }}</p>
  <p><span class="font-semibold">Price:</span> {{ product.size }}</p>
</div>

<div class="mt-6 flex space-x-4">
  <a href="{{ path('app_product_edit', {'id': product.id}) }}" 
     class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600">Edit</a>

  {{ include('product/_delete_form.html.twig') }}

  <a href="{{ path('app_product_index') }}" 
     class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">Back to list</a>
</div>
{% endblock %}
