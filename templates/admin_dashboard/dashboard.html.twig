{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}Admin Dashboard – LuxePaws{% endblock %}

{% block content %}
<section class="p-8 bg-[#fdfdfd] rounded-2xl shadow-lg border border-gray-200">
  <!-- Header -->
  <div class="text-center mb-10">
    <h1 class="text-4xl font-extrabold text-[var(--navy)] mb-2">Welcome, Admin</h1>
    <p class="text-gray-600 text-sm">Here’s an overview of LuxePaws’ latest activities and performance.</p>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 mb-6">
    <div class="bg-gradient-to-br from-yellow-100 to-yellow-50 p-6 rounded-xl border border-yellow-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">Appointments</p>
          <p class="text-3xl font-bold text-[var(--navy)] mt-1">{{ totalAppointments }}</p>
        </div>
        <i class="fa-solid fa-calendar-days text-yellow-600 text-3xl"></i>
      </div>
    </div>

    <div class="bg-gradient-to-br from-blue-100 to-blue-50 p-6 rounded-xl border border-blue-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">Services</p>
          <p class="text-3xl font-bold text-[var(--navy)] mt-1">{{ totalServices }}</p>
        </div>
        <i class="fa-solid fa-scissors text-blue-600 text-3xl"></i>
      </div>
    </div>

    <div class="bg-gradient-to-br from-green-100 to-green-50 p-6 rounded-xl border border-green-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">Messages</p>
          <p class="text-3xl font-bold text-[var(--navy)] mt-1">{{ totalContacts }}</p>
        </div>
        <i class="fa-solid fa-envelope text-green-600 text-3xl"></i>
      </div>
    </div>

    <div class="bg-gradient-to-br from-pink-100 to-pink-50 p-6 rounded-xl border border-pink-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">Users</p>
          <p class="text-3xl font-bold text-[var(--navy)] mt-1">{{ totalUsers }}</p>
        </div>
        <i class="fa-solid fa-user-gear text-pink-500 text-3xl"></i>
      </div>
    </div>
    
    <div class="bg-gradient-to-br from-indigo-100 to-indigo-50 p-6 rounded-xl border border-indigo-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">Staff</p>
          <p class="text-3xl font-bold text-[var(--navy)] mt-1">{{ totalStaff }}</p>
        </div>
        <i class="fa-solid fa-users-line text-indigo-600 text-3xl"></i>
      </div>
    </div>
  </div>

  {# Quick actions removed to emphasize chart area #}

  <!-- Summary Chart -->
  <div class="bg-white border border-gray-200 rounded-2xl shadow-inner p-8 mb-10 group">
    <h2 class="text-2xl font-bold text-[var(--navy)] mb-6 text-center">Summary Overview</h2>
    {# Quick-action buttons removed as requested #}

    <canvas id="summaryChart" data-chart='{{ [totalAppointments, totalServices, totalContacts, totalUsers, totalStaff]|json_encode|e("html_attr") }}' class="w-full max-w-5xl mx-auto"></canvas>
  </div>

  <!-- Recent Activity Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Recent Appointments -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-[var(--navy)] mb-4">Recent Appointments</h2>
      <ul class="divide-y divide-gray-200">
        {% for appt in recentAppointments %}
          <li class="py-3 flex justify-between items-center text-gray-700">
            <div>
              <span class="font-semibold text-[var(--navy)]">{{ appt.petName }}</span>
              <span class="text-sm text-gray-500">by {{ appt.ownerName }}</span>
            </div>
            <span class="text-sm text-gray-500">{{ appt.appointmentDate|date('M d, Y') }}</span>
          </li>
        {% else %}
          <li class="py-3 text-gray-400 italic text-center">No recent appointments found.</li>
        {% endfor %}
      </ul>
    </div>

    <!-- Recent Messages -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-[var(--navy)] mb-4">Recent Messages</h2>
      <ul class="divide-y divide-gray-200">
        {% for msg in recentMessages %}
          <li class="py-3">
            <div class="flex justify-between items-center">
              <div>
                <p class="font-semibold text-[var(--navy)]">{{ msg.firstName }} {{ msg.lastName }}</p>
                <p class="text-sm text-gray-600 italic truncate max-w-xs">{{ msg.subject }}</p>
              </div>
              <span class="text-sm text-gray-500">{{ msg.submittedAt ? msg.submittedAt|date('M d, Y') : '—' }}</span>
            </div>
          </li>
        {% else %}
          <li class="py-3 text-gray-400 italic text-center">No recent messages found.</li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <!-- Recent Activities -->
  <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 mt-8">
    <h2 class="text-2xl font-bold text-[var(--navy)] mb-4">Recent Activities</h2>
    <ul class="divide-y divide-gray-200">
      {% for act in recentActivities %}
        <li class="py-3 flex justify-between items-center text-gray-700">
          <div>
            <div class="font-semibold text-[var(--navy)]">{{ act.username }} — {{ act.action }}</div>
            <div class="text-sm text-gray-500">{{ act.targetData }}</div>
          </div>
          <div class="text-sm text-gray-500">{{ act.createdAt ? act.createdAt|date('M d, Y H:i') : '—' }}</div>
        </li>
      {% else %}
        <li class="py-3 text-gray-400 italic text-center">No recent activity found.</li>
      {% endfor %}
    </ul>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const canvas = document.getElementById('summaryChart');
  if (!canvas) return; // guard for pages without the chart element
  const chartData = JSON.parse(canvas.getAttribute('data-chart') || '[]');
  const ctx = canvas.getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Appointments', 'Services', 'Messages', 'Users', 'Staff'],
      datasets: [{
        label: 'Counts',
        data: chartData,
        backgroundColor: [
          'rgba(33, 150, 243, 0.9)',
          'rgba(59, 130, 246, 0.8)',
          'rgba(34, 197, 94, 0.8)',
          'rgba(249, 115, 22, 0.85)',
          'rgba(168, 85, 247, 0.8)'
        ],
        borderColor: [
          'rgba(33, 150, 243, 1)',
          'rgba(59, 130, 246, 1)',
          'rgba(34, 197, 94, 1)',
          'rgba(249, 115, 22, 1)',
          'rgba(168, 85, 247, 1)'
        ],
        borderWidth: 2,
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      scales: {
        x: { ticks: { color: '#333', font: { size: 13 } } },
        y: { beginAtZero: true, ticks: { color: '#333', font: { size: 13 } } }
      },
      plugins: {
        legend: { labels: { color: '#333', font: { size: 14 } } },
        tooltip: { bodyColor: '#111', titleColor: '#111' }
      }
    }
  });
});
</script>
{% endblock %}
