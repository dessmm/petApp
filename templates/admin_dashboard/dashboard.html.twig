{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}Admin Dashboard – LuxePaws{% endblock %}

{% block content %}
<section class="p-8 bg-[#fdfdfd] rounded-2xl shadow-lg border border-gray-200">
  <!-- Header -->
  <div class="text-center mb-10">
    <h1 class="text-4xl font-extrabold text-[var(--navy)] mb-2">Welcome, Admin 🐾</h1>
    <p class="text-gray-600 text-sm">Here’s an overview of LuxePaws’ latest activities and performance.</p>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <div class="bg-gradient-to-br from-yellow-100 to-yellow-50 p-6 rounded-xl border border-yellow-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">Appointments</p>
          <p class="text-3xl font-bold text-[var(--navy)] mt-1">{{ totalAppointments }}</p>
        </div>
        <i class="fa-solid fa-calendar-days text-yellow-600 text-3xl"></i>
      </div>
    </div>

    <div class="bg-gradient-to-br from-blue-100 to-blue-50 p-6 rounded-xl border border-blue-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">Services</p>
          <p class="text-3xl font-bold text-[var(--navy)] mt-1">{{ totalServices }}</p>
        </div>
        <i class="fa-solid fa-scissors text-blue-600 text-3xl"></i>
      </div>
    </div>

    <div class="bg-gradient-to-br from-green-100 to-green-50 p-6 rounded-xl border border-green-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">Messages</p>
          <p class="text-3xl font-bold text-[var(--navy)] mt-1">{{ totalContacts }}</p>
        </div>
        <i class="fa-solid fa-envelope text-green-600 text-3xl"></i>
      </div>
    </div>

    <div class="bg-gradient-to-br from-pink-100 to-pink-50 p-6 rounded-xl border border-pink-200 shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 uppercase">New Messages</p>
          <p class="text-3xl font-bold text-pink-700 mt-1">{{ newMessages }}</p>
        </div>
        <i class="fa-solid fa-comment-dots text-pink-500 text-3xl"></i>
      </div>
    </div>
  </div>

  <!-- Chart -->
  <div class="bg-white border border-gray-200 rounded-2xl shadow-inner p-8 mb-10">
    <h2 class="text-2xl font-bold text-[var(--navy)] mb-6 text-center">Summary Overview</h2>
    <canvas id="summaryChart" class="w-full max-w-4xl mx-auto"></canvas>
  </div>

  <!-- Quick Actions -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
    <a href="{{ path('app_admin_appointments_index') }}"
       class="flex flex-col items-center justify-center p-6 bg-blue-100 hover:bg-blue-200 rounded-xl shadow text-blue-700 font-semibold transition">
      <i class="fa-solid fa-calendar text-3xl mb-2"></i>
      Manage Appointments
    </a>

    <a href="{{ path('app_admin_services_index') }}"
       class="flex flex-col items-center justify-center p-6 bg-yellow-100 hover:bg-yellow-200 rounded-xl shadow text-yellow-700 font-semibold transition">
      <i class="fa-solid fa-scissors text-3xl mb-2"></i>
      Manage Services
    </a>

    <a href="{{ path('app_admin_contacts_index') }}"
       class="flex flex-col items-center justify-center p-6 bg-green-100 hover:bg-green-200 rounded-xl shadow text-green-700 font-semibold transition">
      <i class="fa-solid fa-envelope-open-text text-3xl mb-2"></i>
      View Messages
    </a>
  </div>

  <!-- Recent Activity -->
  <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8">
    <h2 class="text-2xl font-bold text-[var(--navy)] mb-4">Recent Appointments</h2>
    <ul class="divide-y divide-gray-200">
      {% for appt in recentAppointments %}
        <li class="py-3 flex justify-between items-center text-gray-700">
          <div>
            <span class="font-semibold text-[var(--navy)]">{{ appt.petName }}</span>
            <span class="text-sm text-gray-500">by {{ appt.ownerName }}</span>
          </div>
          <span class="text-sm text-gray-500">{{ appt.appointmentDate|date('M d, Y') }}</span>
        </li>
      {% else %}
        <li class="py-3 text-gray-400 italic text-center">No recent appointments found.</li>
      {% endfor %}
    </ul>
  </div>
</section>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const ctx = document.getElementById('summaryChart').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Appointments', 'Services', 'Messages', 'New Messages'],
      datasets: [{
        label: 'Dashboard Overview',
        data: [{{ totalAppointments }}, {{ totalServices }}, {{ totalContacts }}, {{ newMessages }}],
        backgroundColor: [
          'rgba(33, 150, 243, 0.8)',
          'rgba(255, 215, 0, 0.8)',
          'rgba(76, 175, 80, 0.8)',
          'rgba(233, 30, 99, 0.8)'
        ],
        borderColor: [
          'rgba(33, 150, 243, 1)',
          'rgba(255, 215, 0, 1)',
          'rgba(76, 175, 80, 1)',
          'rgba(233, 30, 99, 1)'
        ],
        borderWidth: 2,
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      scales: {
        x: { ticks: { color: '#333', font: { size: 13 } } },
        y: { beginAtZero: true, ticks: { color: '#333', font: { size: 13 } } }
      },
      plugins: {
        legend: { labels: { color: '#333', font: { size: 14 } } }
      }
    }
  });
});
</script>
{% endblock %}
