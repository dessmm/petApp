<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Admin Dashboard – LuxePaws{% endblock %}</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">

  <style>
    :root {
      --navy: #1C1F3A;
      --gold: #D4AF37;
      --cream: #F9F6F0;
    }
    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--cream);
    }

    .dataTables_wrapper .dataTables_filter input {
      background-color: #2B3147;
      color: white;
      border: 1px solid #555;
      border-radius: 6px;
      padding: 6px 10px;
    }
  </style>

  {% block styles %}{% endblock %}
</head>

<body class="flex min-h-screen">
  <aside class="w-64 bg-[var(--navy)] text-white flex flex-col shadow-lg">
    <div class="p-5 text-2xl font-bold border-b border-white/20">
      Admin Panel
    </div>
    <nav class="flex-1 p-4 space-y-2 text-sm">
      <a href="{{ path('app_admin_dashboard') }}" class="block px-3 py-2 rounded hover:bg-[var(--gold)] hover:text-[var(--navy)] transition">Dashboard</a>
      <a href="{{ path('app_admin_appointments_index') }}" class="block px-3 py-2 rounded hover:bg-[var(--gold)] hover:text-[var(--navy)] transition">Appointments</a>
      <a href="{{ path('app_admin_services_index') }}" class="block px-3 py-2 rounded hover:bg-[var(--gold)] hover:text-[var(--navy)] transition">Services</a>
      <a href="{{ path('app_admin_contacts_index') }}" class="block px-3 py-2 rounded hover:bg-[var(--gold)] hover:text-[var(--navy)] transition">Messages</a>
    </nav>
    <div class="p-4 border-t border-white/20 text-sm">
      <a href="{{ path('app_home') }}" class="hover:text-[var(--gold)] transition">← Back to Site</a>
    </div>
  </aside>

  <main class="flex-1 p-8 overflow-y-auto">
    {% block content %}{% endblock %}
  </main>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>

  {% block javascripts %}{% endblock %}
</body>
</html>
