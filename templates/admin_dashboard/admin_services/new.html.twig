{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}Add Service – Admin{% endblock %}

{% block content %}
<section class="p-6 bg-[#1E2435] rounded-2xl shadow-lg border border-gray-700 max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-3xl font-bold text-white">Add Service</h1>
      <p class="text-sm text-gray-300">Create a new service entry.</p>
    </div>

    <a href="{{ path('app_admin_services_index') }}"
       class="px-3 py-2 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
      ← Back
    </a>
  </div>

  {{ include('admin_dashboard/admin_services/_form.html.twig', {'form': form, 'button_label': 'Create Service'}) }}
</section>
{% endblock %}
