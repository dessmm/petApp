{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
  <div>
    {{ form_label(form.name, 'Service Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
    {{ form_widget(form.name, {'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--gold)] outline-none'}}) }}
    {{ form_errors(form.name) }}
  </div>

  <div>
    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
    {{ form_widget(form.description, {'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--gold)] outline-none'}}) }}
    {{ form_errors(form.description) }}
  </div>

  <div>
    {{ form_label(form.price, 'Price', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
    {{ form_widget(form.price, {'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--gold)] outline-none'}}) }}
    {{ form_errors(form.price) }}
  </div>

  <div class="text-center pt-4">
    <button type="submit"
            class="px-6 py-3 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
      {{ button_label|default('Save') }}
    </button>
  </div>
{{ form_end(form) }}
