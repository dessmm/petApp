{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}Edit Service – LuxePaws{% endblock %}

{% block content %}
<section class="p-10 bg-white rounded-2xl shadow-lg border border-gray-200 max-w-4xl mx-auto mt-10 text-gray-800">
  <div class="flex items-center justify-between mb-8 border-b border-gray-300 pb-4">
    <div>
      <h1 class="text-3xl font-bold text-[var(--navy)] tracking-wide">Edit Service</h1>
      <p class="text-sm text-gray-500">Modify the service details below and click update to save changes.</p>
    </div>

    <a href="{{ path('app_admin_services_index') }}"
       class="px-5 py-2 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
      ← Back
    </a>
  </div>

  <div class="bg-[#f9fafc] border border-gray-200 rounded-xl p-8 shadow-inner">
    {{ include('admin_dashboard/admin_services/_form.html.twig', {
      'button_label': 'Update Service'
    }) }}
  </div>

  <div class="flex justify-end mt-8">
    <form method="post" action="{{ path('app_admin_services_delete', {'id': service.id}) }}" 
          onsubmit="return confirm('Are you sure you want to delete this service?');">
      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
      <button class="px-6 py-2 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg shadow transition">
        Delete
      </button>
    </form>
  </div>
</section>

<style>
  section {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.7s ease-out;
  }
  section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  input, textarea, select {
    background-color: #fff !important;
    color: #1E2435 !important;
    border: 1px solid #ccc !important;
    border-radius: 8px;
    padding: 10px;
    width: 100%;
    transition: all 0.2s ease;
  }
  input:focus, textarea:focus, select:focus {
    border-color: var(--gold) !important;
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.3);
    outline: none;
  }
  label {
    color: #1E2435 !important;
    font-weight: 600;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('section');
    setTimeout(() => section.classList.add('visible'), 150);
  });
</script>
{% endblock %}
