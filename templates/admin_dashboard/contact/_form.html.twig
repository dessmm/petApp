{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
  <div>
    {{ form_label(form.firstName, 'First Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-200 mb-1'}}) }}
    {{ form_widget(form.firstName, {'attr': {'class': 'w-full p-3 rounded-lg bg-[#2B3147] border border-gray-600 text-gray-100 focus:ring-2 focus:ring-[var(--gold)]'}}) }}
    {{ form_errors(form.firstName) }}
  </div>

  <div>
    {{ form_label(form.lastName, 'Last Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-200 mb-1'}}) }}
    {{ form_widget(form.lastName, {'attr': {'class': 'w-full p-3 rounded-lg bg-[#2B3147] border border-gray-600 text-gray-100 focus:ring-2 focus:ring-[var(--gold)]'}}) }}
    {{ form_errors(form.lastName) }}
  </div>

  <div>
    {{ form_label(form.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-200 mb-1'}}) }}
    {{ form_widget(form.email, {'attr': {'class': 'w-full p-3 rounded-lg bg-[#2B3147] border border-gray-600 text-gray-100 focus:ring-2 focus:ring-[var(--gold)]'}}) }}
    {{ form_errors(form.email) }}
  </div>

  <div>
    {{ form_label(form.subject, 'Subject', {'label_attr': {'class': 'block text-sm font-medium text-gray-200 mb-1'}}) }}
    {{ form_widget(form.subject, {'attr': {'class': 'w-full p-3 rounded-lg bg-[#2B3147] border border-gray-600 text-gray-100 focus:ring-2 focus:ring-[var(--gold)]'}}) }}
    {{ form_errors(form.subject) }}
  </div>

  <div>
    {{ form_label(form.message, 'Message', {'label_attr': {'class': 'block text-sm font-medium text-gray-200 mb-1'}}) }}
    {{ form_widget(form.message, {'attr': {'class': 'w-full p-3 rounded-lg bg-[#2B3147] border border-gray-600 text-gray-100 focus:ring-2 focus:ring-[var(--gold)]', 'rows': 5}}) }}
    {{ form_errors(form.message) }}
  </div>

  {% if form.status is defined %}
  <div>
    {{ form_label(form.status, 'Status', {'label_attr': {'class': 'block text-sm font-medium text-gray-200 mb-1'}}) }}
    {{ form_widget(form.status, {'attr': {'class': 'w-full p-3 rounded-lg bg-[#2B3147] border border-gray-600 text-gray-100 focus:ring-2 focus:ring-[var(--gold)]'}}) }}
    {{ form_errors(form.status) }}
  </div>
  {% endif %}

  <div class="pt-4 text-center">
    <button class="px-6 py-3 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
      {{ button_label|default('Save') }}
    </button>
  </div>
{{ form_end(form) }}
