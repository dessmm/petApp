{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}Appointment Details – Admin{% endblock %}

{% block content %}
<section class="p-6 bg-[#1E2435] rounded-2xl shadow-lg border border-gray-700">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold text-white">Appointment Details</h1>
    <a href="{{ path('app_admin_appointments_index') }}"
       class="px-4 py-2 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
      ← Back to List
    </a>
  </div>

  <div class="bg-[#2B3147] p-8 rounded-xl border border-gray-600 shadow-lg text-gray-100">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div>
        <h2 class="text-sm uppercase text-gray-400 tracking-wider">Pet Name</h2>
        <p class="text-xl font-semibold text-[var(--gold)] mt-1">{{ appointment.petName }}</p>
      </div>
      <div>
        <h2 class="text-sm uppercase text-gray-400 tracking-wider">Owner</h2>
        <p class="text-lg font-medium text-white mt-1">{{ appointment.ownerName }}</p>
        <p class="text-sm text-gray-300">{{ appointment.ownerEmail }}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div>
        <h2 class="text-sm uppercase text-gray-400 tracking-wider">Date</h2>
        <p class="text-lg font-medium text-white mt-1">
          {{ appointment.appointmentDate ? appointment.appointmentDate|date('M d, Y') : '' }}
        </p>
      </div>
      <div>
        <h2 class="text-sm uppercase text-gray-400 tracking-wider">Time</h2>
        <p class="text-lg font-medium text-white mt-1">
          {{ appointment.appointmentTime ? appointment.appointmentTime|date('H:i') : '' }}
        </p>
      </div>
    </div>

    <div class="mb-6">
      <h2 class="text-sm uppercase text-gray-400 tracking-wider">Service</h2>
      <p class="text-lg font-semibold text-[var(--gold)] mt-1">
        {{ appointment.service ? appointment.service.name : 'N/A' }}
      </p>
    </div>
  </div>

  <div class="mt-8 flex flex-wrap gap-4">
    <a href="{{ path('app_admin_appointments_edit', {'id': appointment.id}) }}" 
       class="px-4 py-2 bg-yellow-500 text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
      ✎ Edit
    </a>
    <form method="post" action="{{ path('app_admin_appointments_delete', {'id': appointment.id}) }}" 
          onsubmit="return confirm('Are you sure you want to delete this appointment?');" 
          class="inline-block">
      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
      <button class="px-4 py-2 bg-red-600 text-white font-semibold rounded-lg shadow hover:bg-red-700 transition">
        🗑 Delete
      </button>
    </form>
  </div>
</section>
{% endblock %}
