{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}User Details{% endblock %}

{% block content %}

<div class="max-w-5xl mx-auto">

    <!-- Breadcrumb -->
    <div class="text-sm text-gray-600 mb-6">
        <a href="{{ path('app_admin_user_index') }}" class="hover:text-[var(--gold)]">User Accounts</a>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-[var(--navy)] font-semibold">{{ user.username }}</span>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8">

        <h1 class="text-3xl font-bold text-[var(--navy)] mb-6">User Details</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div class="p-4 bg-gray-50 border rounded-xl">
                <p class="text-xs text-gray-500">ID</p>
                <p class="font-semibold text-[var(--navy)]">{{ user.id }}</p>
            </div>

            <div class="p-4 bg-gray-50 border rounded-xl">
                <p class="text-xs text-gray-500">Username</p>
                <p class="font-semibold text-[var(--navy)]">{{ user.username }}</p>
            </div>

            <div class="p-4 bg-gray-50 border rounded-xl">
                <p class="text-xs text-gray-500">Email</p>
                <p class="font-semibold text-[var(--navy)]">{{ user.email }}</p>
            </div>

            <div class="p-4 bg-gray-50 border rounded-xl">
                <p class="text-xs text-gray-500">Full Name</p>
                <p class="font-semibold text-[var(--navy)]">{{ user.fullName }}</p>
            </div>

            <!-- Role Badge -->
            <div class="p-4 bg-gray-50 border rounded-xl">
                <p class="text-xs text-gray-500">Role</p>

                {% set role = user.roles[0] %}
                {% if role == 'ROLE_ADMIN' %}
                    <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm">Admin</span>
                {% elseif role == 'ROLE_STAFF' %}
                    <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm">Staff</span>
                {% else %}
                    <span class="px-3 py-1 bg-gray-200 text-gray-700 rounded-full text-sm">User</span>
                {% endif %}
            </div>

            <!-- Active Status -->
            <div class="p-4 bg-gray-50 border rounded-xl">
                <p class="text-xs text-gray-500">Status</p>
                    {% if user.archivedAt is not null %}
                        <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">Archived</span>
                    {% elseif user.isActive %}
                        <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm">Active</span>
                    {% else %}
                        <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm">Inactive</span>
                    {% endif %}
            </div>

            <!-- Created At -->
            <div class="p-4 bg-gray-50 border rounded-xl md:col-span-2">
                <p class="text-xs text-gray-500">Created At</p>
                <p class="font-semibold text-[var(--navy)]">
                    {{ user.createdAt|date('M d, Y h:i A') }}
                </p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 mt-8">

            <a href="{{ path('app_admin_user_index') }}"
               class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
               Back
            </a>

            <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}"
               class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
               Edit
            </a>

            <!-- Delete Button -->
            {{ include('admin_user/_delete_form.html.twig') }}

        </div>

    </div>

</div>

{# Delete confirmation modal (included here so delete on the show page works) #}
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center">
    <div class="fixed inset-0 bg-black/50" data-action="close-modal"></div>
    <div class="relative bg-white rounded-2xl shadow-lg w-full max-w-md mx-4">
        <div class="p-6">
            <h3 class="text-xl font-bold text-[var(--navy)] mb-2">Confirm Delete</h3>
            <p id="deleteModalBody" class="text-sm text-gray-600 mb-6">Are you sure you want to delete this user? This action cannot be undone.</p>
            <div class="flex justify-end space-x-3">
                <button id="deleteModalCancel" class="px-4 py-2 bg-gray-200 text-[var(--navy)] rounded-lg hover:bg-gray-300">Cancel</button>
                <button id="deleteModalConfirm" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">Delete</button>
            </div>
        </div>
    </div>
</div>

{% block javascripts_extra %}
    <script>
        (function(){
            function onReady(fn){
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', fn);
                } else { fn(); }
            }

            onReady(function(){
                const modal = document.getElementById('deleteModal');
                const modalBody = document.getElementById('deleteModalBody');
                const btnCancel = document.getElementById('deleteModalCancel');
                const btnConfirm = document.getElementById('deleteModalConfirm');
                let currentUserId = null;

                function openModal(userId, username){
                    currentUserId = userId;
                    if (modalBody) modalBody.textContent = `Are you sure you want to delete the user "${username}"? This action cannot be undone.`;
                    if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
                }
                function closeModal(){ currentUserId = null; if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); } }

                document.querySelectorAll('.open-delete-modal').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const id = btn.dataset.userId || btn.closest('form')?.id?.replace('delete-user-form-','');
                        const username = btn.dataset.username || '';
                        openModal(id, username);
                    });
                });

                if (btnCancel) btnCancel.addEventListener('click', closeModal);
                const closeBackdrop = modal && modal.querySelector('[data-action="close-modal"]');
                if (closeBackdrop) closeBackdrop.addEventListener('click', closeModal);

                if (btnConfirm) btnConfirm.addEventListener('click', () => {
                    if (!currentUserId) return closeModal();
                    const form = document.getElementById('delete-user-form-' + currentUserId);
                    if (form) form.submit();
                    closeModal();
                });
            });
        })();
    </script>
{% endblock %}

{% endblock %}
