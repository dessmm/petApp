{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block content %}
<section class="p-8 bg-white rounded-2xl shadow-lg border border-gray-200 max-w-4xl mx-auto">

  <!-- Breadcrumb + Title -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-3xl font-bold text-[var(--navy)]">Edit User</h1>
      <p class="text-gray-600 text-sm mt-1">Update user details, reset password, or change access role.</p>
    </div>

    <a href="{{ path('app_admin_user_index') }}"
       class="px-4 py-2 bg-gray-200 text-[var(--navy)] rounded-lg hover:bg-gray-300 transition shadow-sm">
       ← Back to User List
    </a>
  </div>

  <!-- Main Form Card -->
  <div class="p-8 bg-[#f8f9fc] border border-gray-200 rounded-xl shadow-inner">

    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

      <!-- Username -->
      <div>
        {{ form_label(form.username, null, {
            'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1'}
        }) }}
        {{ form_widget(form.username, {
            'attr': {'class': 'w-full px-4 py-3 bg-white border rounded-lg 
                              focus:ring-[var(--gold)] focus:border-[var(--gold)] transition'}
        }) }}
        <p class="text-xs text-gray-500 mt-1">This is the login identifier.</p>
      </div>

      <!-- Email -->
      <div>
        {{ form_label(form.email, null, {
            'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1'}
        }) }}
        {{ form_widget(form.email, {
            'attr': {'class': 'w-full px-4 py-3 bg-white border rounded-lg 
                              focus:ring-[var(--gold)] focus:border-[var(--gold)] transition'}
        }) }}
      </div>

      <!-- Full Name -->
      <div>
        {{ form_label(form.fullName, null, {
            'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1'}
        }) }}
        {{ form_widget(form.fullName, {
            'attr': {'class': 'w-full px-4 py-3 bg-white border rounded-lg 
                              focus:ring-[var(--gold)] focus:border-[var(--gold)] transition'}
        }) }}
      </div>

      <!-- User Role -->
    <div>
    {{ form_label(form.roles, 'Role', {
        'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1'}
    }) }}
    {{ form_widget(form.roles, {
        'attr': {'class': 'w-full bg-white border border-gray-300 rounded-lg 
                          focus:ring-[var(--gold)] focus:border-[var(--gold)] 
                          pl-4 pr-10 py-3 appearance-none relative'
                        }
     }) }}
    </div>

    <!-- Custom Arrow Icon -->
    <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-500">
      ▼
    </div>
  </div>

  <p class="text-xs text-gray-500 mt-1">
    Select Admin, Staff, or Standard User.
  </p>
</div>


      <!-- Password -->
      <div>
        {{ form_label(form.plainPassword, 'New Password', {
            'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1'}
        }) }}
        {{ form_widget(form.plainPassword, {
            'attr': {'class': 'w-full px-4 py-3 bg-white border rounded-lg 
                              focus:ring-[var(--gold)] focus:border-[var(--gold)] transition'}
        }) }}
        <p class="text-xs text-gray-500 mt-1 italic">
          Leave blank if you do not want to change the password.
        </p>
      </div>

      <!-- Active Toggle -->
      <div class="flex items-center gap-3 mt-3">
        {{ form_widget(form.isActive, {'attr': {'class': 'h-4 w-4'}}) }}
        {{ form_label(form.isActive, null, {
            'label_attr': {'class': 'font-semibold text-[var(--navy)]'}
        }) }}
      </div>

      <!-- Archived Toggle -->
      <div class="flex items-center gap-3 mt-3">
        {{ form_widget(form.archived, {'attr': {'class': 'h-4 w-4'}}) }}
        {{ form_label(form.archived, null, {
            'label_attr': {'class': 'font-semibold text-[var(--navy)]'}
        }) }}
      </div>

      <!-- Submit Button -->
      <button
        class="w-full py-3 bg-blue-600 text-white font-bold rounded-lg shadow hover:bg-blue-700 transition">
        Update User
      </button>

    {{ form_end(form) }}

  </div>

</section>
{% endblock %}
