{% extends 'admin_dashboard/base.html.twig' %}

{% block title %}Create User{% endblock %}

{% block content %}
<section class="p-6 bg-white rounded-2xl shadow-lg border border-gray-200 max-w-3xl mx-auto">

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold text-[var(--navy)]">Create User</h1>
    <a href="{{ path('app_admin_user_index') }}"
       class="px-3 py-2 bg-gray-200 text-[var(--navy)] rounded-lg hover:bg-gray-300 transition">
       Back
    </a>
  </div>

  <div class="p-4 bg-[#f8f9fc] border border-gray-200 rounded-xl">

    {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

      {% if not form.vars.valid %}
        <div class="mb-4 p-3 bg-red-100 border border-red-300 text-red-800 rounded-lg text-sm">
            <strong>Unable to create user.</strong>
            <ul class="mt-1 list-disc list-inside">
                {% for error in form.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
      {% endif %}

      <!-- Username -->
      <div>
        {{ form_label(form.username, null, {'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1 text-sm'}}) }}
        {{ form_widget(form.username, {'attr': {'class': 'w-full px-3 py-2 bg-white border rounded-lg focus:ring-[var(--gold)] text-sm'}}) }}
        <div class="text-red-600 text-xs">{{ form_errors(form.username) }}</div>
      </div>

      <!-- Email -->
      <div>
        {{ form_label(form.email, null, {'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1 text-sm'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'w-full px-3 py-2 bg-white border rounded-lg focus:ring-[var(--gold)] text-sm'}}) }}
        <div class="text-red-600 text-xs">{{ form_errors(form.email) }}</div>
      </div>

      <!-- Full Name -->
      <div>
        {{ form_label(form.fullName, null, {'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1 text-sm'}}) }}
        {{ form_widget(form.fullName, {'attr': {'class': 'w-full px-3 py-2 bg-white border rounded-lg focus:ring-[var(--gold)] text-sm'}}) }}
        <div class="text-red-600 text-xs">{{ form_errors(form.fullName) }}</div>
      </div>

      <!-- Role -->
      <div>
        {{ form_label(form.roles, 'Role', {'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1 text-sm'}}) }}
        {{ form_widget(form.roles, {'attr': {'class': 'w-full px-3 py-2 bg-white border rounded-lg text-sm'}}) }}
        <div class="text-red-600 text-xs">{{ form_errors(form.roles) }}</div>
      </div>

      <!-- Password -->
      <div>
        {{ form_label(form.plainPassword, 'Password', {'label_attr': {'class': 'block font-semibold text-[var(--navy)] mb-1 text-sm'}}) }}
        {{ form_widget(form.plainPassword, {'attr': {'class': 'w-full px-3 py-2 bg-white border rounded-lg focus:ring-[var(--gold)] text-sm'}}) }}
        <div class="text-red-600 text-xs">{{ form_errors(form.plainPassword) }}</div>
      </div>

      {# isActive intentionally hidden on create. New users default to active on server-side. #}

      <button class="w-full py-2 bg-[var(--gold)] text-[var(--navy)] font-bold rounded-lg hover:bg-yellow-400 transition text-sm">
        Create User
      </button>

    {# Render CSRF token explicitly and avoid rendering remaining fields (isActive/archived) on create #}
    {% if form._token is defined %}
      {{ form_widget(form._token) }}
    {% endif %}
    {{ form_end(form, { 'render_rest': false }) }}

  </div>

</section>
{% endblock %}
