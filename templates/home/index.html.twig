{% extends 'base.html.twig' %}

{% block title %}LuxePaws – Premium Pet Grooming Appointments{% endblock %}

{% block content %}

<style>
  .fade-section {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease-out;
  }
  .fade-in {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<section class="text-center py-20 bg-gradient-to-b from-white to-[var(--cream)] rounded-3xl shadow-sm fade-section">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-5xl font-bold text-[var(--navy)] leading-tight mb-4">
      Premium Pet Grooming, <span class="text-[var(--gold)]">Made Simple</span>
    </h1>
    <p class="text-gray-600 text-lg mb-8">
      Book trusted veterinary-certified groomers in just a few clicks. Keep your pets calm, clean, and cared for — anytime, anywhere.
    </p>
    <a href="{{ path('app_appointment_new') }}"
       class="inline-block px-8 py-3 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-xl shadow hover:bg-yellow-400 transition">
       Book an Appointment
    </a>
  </div>

  <div class="mt-12 flex justify-center">
    <img src="/images/petgrooming3.jpg" alt="Pet Grooming" class="max-w-md rounded-xl shadow-md">
  </div>
</section>

<section id="features" class="mt-24 text-center fade-section">
  <h2 class="text-3xl font-bold text-[var(--navy)] mb-4">Our Key Features</h2>
  <p class="text-gray-600 mb-12 max-w-2xl mx-auto">
    LuxePaws provides everything you need to manage grooming appointments effortlessly.
  </p>

  <div class="grid md:grid-cols-3 gap-8">
    <div class="bg-white p-8 rounded-2xl shadow hover:shadow-lg transition">
      <div class="text-4xl text-[var(--gold)] mb-4">💻</div>
      <h3 class="text-xl font-semibold text-[var(--navy)]">Online Booking</h3>
      <p class="text-gray-600 mt-2">Easily schedule appointments online, anytime, anywhere.</p>
    </div>

    <div class="bg-white p-8 rounded-2xl shadow hover:shadow-lg transition">
      <div class="text-4xl text-[var(--gold)] mb-4">🐶</div>
      <h3 class="text-xl font-semibold text-[var(--navy)]">Pet Profiles</h3>
      <p class="text-gray-600 mt-2">Save pet details, preferences, and health notes for quick bookings.</p>
    </div>

    <div class="bg-white p-8 rounded-2xl shadow hover:shadow-lg transition">
      <div class="text-4xl text-[var(--gold)] mb-4">🔔</div>
      <h3 class="text-xl font-semibold text-[var(--navy)]">Reminders</h3>
      <p class="text-gray-600 mt-2">Receive real-time updates and appointment reminders automatically.</p>
    </div>
  </div>
</section>

<section id="about" class="mt-24 grid md:grid-cols-2 gap-10 items-center bg-white p-10 rounded-3xl shadow-lg fade-section">
  <div>
    <h2 class="text-3xl font-bold text-[var(--navy)] mb-4">About LuxePaws</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      LuxePaws is your go-to online system for veterinary-certified pet grooming appointments.
      We connect pet owners with trusted professionals, ensuring top-quality grooming care
      while simplifying the scheduling process through an easy-to-use digital platform.
    </p>
    <ul class="space-y-2 text-gray-700">
      <li>✔ Seamless appointment management</li>
      <li>✔ Certified and experienced groomers</li>
      <li>✔ Membership and priority booking options</li>
    </ul>
  </div>
  <div class="flex justify-center">
    <img src="/images/about.jpg" alt="About LuxePaws" class="rounded-2xl shadow-xl w-96 hover:scale-105 transition">
  </div>
</section>

<section id="reviews" class="mt-24 text-center fade-section">
  <h2 class="text-3xl font-bold text-[var(--navy)] mb-4">Happy Clients, Happier Pets</h2>
  <p class="text-gray-600 mb-10">What our customers say about LuxePaws</p>
  
  <div class="grid md:grid-cols-3 gap-6">
    {% for r in reviews|default([
      {'author': 'Maria D.', 'comment': 'My dog looked amazing! Booking was so easy.', 'stars': 5},
      {'author': 'John P.', 'comment': 'Professional and kind groomers. Highly recommended.', 'stars': 5},
      {'author': 'Lena K.', 'comment': 'Convenient and stress-free experience.', 'stars': 4}
    ]) %}
      <div class="bg-white p-6 rounded-2xl shadow hover:shadow-lg transition">
        <p class="text-yellow-500 text-lg">
          {% for i in 1..r.stars %}★{% endfor %}
        </p>
        <p class="italic text-gray-700 mt-2">“{{ r.comment }}”</p>
        <p class="mt-4 font-semibold text-[var(--navy)]">{{ r.author }}</p>
      </div>
    {% endfor %}
  </div>
</section>

<section class="mt-24 text-center py-16 bg-[var(--navy)] text-white rounded-3xl shadow-lg fade-section">
  <h2 class="text-3xl font-bold mb-4">Ready to Pamper Your Pet?</h2>
  <p class="text-gray-300 mb-6">Join LuxePaws today and enjoy premium grooming made simple.</p>
  <a href="{{ path('app_login') }}"
     class="inline-block px-8 py-3 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-xl shadow hover:bg-yellow-400 transition">
     Get Started
  </a>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fadeSections = document.querySelectorAll('.fade-section');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('fade-in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    fadeSections.forEach(section => observer.observe(section));
  });
</script>

{% endblock %}
