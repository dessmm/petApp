{% extends 'base.html.twig' %}

{% block title %}Profile – Staff{% endblock %}

{% block styles %}
<style>
    header, footer { display: none !important; }
    .layout { display: flex; gap: 1.5rem; align-items: flex-start; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.25rem; box-shadow: 0 6px 18px rgba(15,23,42,0.06); }
    .avatar { width: 84px; height: 84px; border-radius: 9999px; background: linear-gradient(135deg,#f3f4f6,#e5e7eb); display:flex;align-items:center;justify-content:center;font-weight:700;color:#475569 }
</style>
{% endblock %}

{% block content %}
<div class="layout">
    {% include 'staff/_sidebar.html.twig' %}

    <div class="flex-1">
        {# Flash messages intentionally hidden on profile to reduce noise #}
        <div class="card">
            <div class="flex items-center gap-6">
                <div class="avatar">{{ profileUser and profileUser.fullName ? profileUser.fullName|slice(0,1)|upper : 'S' }}</div>
                <div>
                    <h1 class="text-2xl font-bold text-[var(--navy)]">{{ profileUser and profileUser.fullName ? profileUser.fullName : 'Staff Member' }}</h1>
                    <p class="text-sm text-gray-500">{{ profileUser and profileUser.username ? '@' ~ profileUser.username : '—' }}</p>
                </div>
            </div>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="text-sm font-semibold text-gray-700">Contact</h3>
                    <p class="mt-2 text-gray-600">Email: <span class="font-medium">{{ profileUser and profileUser.email ? profileUser.email : '—' }}</span></p>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-gray-700">Username</h3>
                    <p class="mt-2 text-gray-600">{{ profileUser and profileUser.username ? profileUser.username : '—' }}</p>
                </div>
            </div>

            <div class="mt-6">
                <div class="flex items-start">
                    <div>
                        <a href="{{ path('staff_profile_change_password') }}" class="inline-block px-4 py-2 bg-yellow-300 text-[var(--navy)] rounded-md text-base font-semibold hover:bg-yellow-300 transition">Change password</a>
                        <h3 class="mt-3 text-l font-semibold text-gray-700">Services Offered</h3>
                    </div>
                </div>
                {% if staff and staff.servicesOffered is not empty %}
                    <ul class="mt-3 divide-y divide-gray-100 rounded-md border border-gray-50 overflow-hidden">
                        {% for service in staff.servicesOffered %}
                            <li class="p-3 flex justify-between items-center">
                                <div>
                                    <div class="font-medium text-gray-800">{{ service.name }}</div>
                                    {% if service.description is defined and service.description %}
                                        <div class="text-sm text-gray-500">{{ service.description }}</div>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="mt-3 text-gray-500 italic">No services assigned.</p>
                    
                {% endif %}
            </div>

            {# Availability feature removed #}
        </div>
    </div>
</div>
{% endblock %}