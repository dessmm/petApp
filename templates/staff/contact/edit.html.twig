{% extends 'base.html.twig' %}

{% block title %}Edit Message – Staff{% endblock %}
{% block styles %}
<style>
  header, footer { display: none !important; }
  .layout { display: flex; gap: 1.5rem; align-items: flex-start; }
  .flex-1 { flex: 1; }
  .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.25rem; box-shadow: 0 6px 18px rgba(15,23,42,0.06); }
</style>
{% endblock %}

{% block content %}
<div class="layout">
    {% include 'staff/_sidebar.html.twig' %}

    <div class="flex-1">
      <section class="max-w-4xl mx-auto bg-[var(--navy)] text-gray-200 p-8 rounded-2xl shadow-lg mt-10">
        <h1 class="text-3xl font-bold text-[var(--gold)] mb-6">Edit Message</h1>

        <div class="bg-[var(--navy)]/60 p-6 rounded-xl border border-gray-600 shadow-md">
          {{ include('staff/contact/_form.html.twig', {
            'button_label': 'Update Message',
            'button_classes': 'w-full py-3 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition'
          }) }}
        </div>

        <div class="mt-8 flex justify-between items-center">
          <a href="{{ path('staff_contacts_index') }}"
             class="px-4 py-2 bg-gray-700 text-gray-100 rounded-lg hover:bg-gray-600 transition flex items-center space-x-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Back to Messages</span>
          </a>

          {{ include('staff/contact/_delete_form.html.twig', { 'contact': contact }) }}
        </div>
      </section>
    </div>
</div>
{% endblock %}