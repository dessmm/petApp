<form method="post"
      action="{{ path('staff_contacts_delete', {'id': contact.id}) }}"
      onsubmit="return confirm('Are you sure you want to delete this message?');"
      class="inline-block">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
  <button class="px-5 py-2 bg-red-600 text-white font-semibold rounded-lg shadow hover:bg-red-700 transition">
    Delete
  </button>
</form>