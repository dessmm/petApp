{% extends 'base.html.twig' %}

{% block title %}Staff Dashboard – LuxePaws{% endblock %}

{% block styles %}

<style> header, footer { display: none !important; } .content { margin-left: calc(16rem + 1.5rem); padding: 2rem; } </style>

{% endblock %}

{% block content %}

{% include 'staff/_sidebar.html.twig' %}

<div class="content bg-white rounded-2xl shadow-lg border border-gray-200 p-8">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-[var(--navy)]">Staff Dashboard</h1>
            <a href="{{ path('app_home') }}" class="px-3 py-1.5 bg-[var(--gold)] text-[var(--navy)] rounded-lg shadow hover:bg-yellow-400 transition text-sm font-medium">
                Back to Home
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 mb-8">
    <div class="p-6 rounded-xl bg-yellow-100 border border-yellow-200 shadow">
        <p class="text-gray-600 text-sm">Pending (Assigned + Pool)</p>
        <p class="text-3xl font-bold text-[var(--navy)]">{{ pending|default(0) }}</p>
        <p class="text-xs text-gray-500">Available pool: {{ availablePending|default(0) }}</p>
    </div>

    <div class="p-6 rounded-xl bg-green-100 border border-green-200 shadow">
        <p class="text-gray-600 text-sm">Accepted</p>
        <p class="text-3xl font-bold text-[var(--navy)]">{{ accepted|default(0) }}</p>
    </div>

    <div class="p-6 rounded-xl bg-white border border-gray-100 shadow">
        <p class="text-gray-600 text-sm">Today's Appointments</p>
        <p class="text-3xl font-bold text-[var(--navy)]">{{ todaysAppointments|length|default(0) }}</p>
    </div>

    <div class="p-6 rounded-xl bg-indigo-50 border border-indigo-100 shadow">
        <p class="text-gray-600 text-sm">Upcoming (7 days)</p>
        <p class="text-3xl font-bold text-[var(--navy)]">{{ upcomingCount|default(0) }}</p>
    </div>

</div>

<h2 class="text-2xl font-bold text-[var(--navy)] mb-4">Today's Appointments</h2>
<div class="bg-gray-50 border border-gray-200 rounded-xl p-6">

    {% if todaysAppointments is empty %}
        <p class="text-gray-500 italic">No appointments for today.</p>
    {% else %}
        <ul class="divide-y divide-gray-300">
            {% for appt in todaysAppointments %}
                <li class="py-4 flex justify-between items-center">
                    <div>
                        <p class="font-semibold text-[var(--navy)]">
                            {{ appt.petName|default('N/A') }}
                            <span class="text-sm text-gray-500"> — {{ appt.ownerName|default('N/A') }}</span>
                        </p>
                        <p class="text-sm text-gray-600">{{ appt.appointmentTime ? appt.appointmentTime|date('h:i A') : 'N/A' }}</p>
                        {% if appt.status %}
                            <span class="inline-block mt-1 text-xs px-2 py-0.5 rounded {{ appt.status == 'Pending' ? 'bg-yellow-200 text-yellow-800' : (appt.status == 'Accepted' ? 'bg-green-200 text-green-800' : 'bg-gray-200 text-gray-800') }}">{{ appt.status }}</span>
                        {% endif %}
                    </div>

                    <div class="flex gap-2">
                        {% if appt.status == 'Pending' %}
                            <form method="post" action="{{ path('staff_accept_appt', { id: appt.id }) }}" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('appointment_accept_' ~ appt.id) }}">
                                <button type="submit" class="px-3 py-1 bg-green-600 text-white rounded-md text-sm hover:bg-green-700">Accept</button>
                            </form>
                            <form method="post" action="{{ path('staff_decline_appt', { id: appt.id }) }}" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('appointment_decline_' ~ appt.id) }}">
                                <button type="submit" class="px-3 py-1 bg-red-600 text-white rounded-md text-sm hover:bg-red-700">Decline</button>
                            </form>
                        {% endif %}

                        {% if appt.status == 'Accepted' and appt.staff is same as(app.user) %}
                            <form method="post" action="{{ path('staff_mark_complete', { id: appt.id }) }}" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('appointment_complete_' ~ appt.id) }}">
                                <button type="submit" class="px-3 py-1 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700">Complete</button>
                            </form>
                        {% endif %}

                                                {% if appt.status != 'Completed' %}
                                                    <a href="{{ path('staff_reschedule_appt', { id: appt.id }) }}" class="px-3 py-1 bg-white border border-gray-200 rounded-md text-sm hover:bg-gray-50">Reschedule</a>
                                                {% endif %}
                        <a href="{{ path('staff_appointments') }}" class="px-3 py-1 bg-gray-100 text-gray-800 rounded-md text-sm">View all</a>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

</div>
</div>

{% endblock %}