{% extends 'base.html.twig' %}

{% block title %}Services{% endblock %}
{% block styles %}
<style>
    header, footer { display: none !important; }
    .layout { display: flex; gap: 1.5rem; align-items: flex-start; }
    .flex-1 { flex: 1; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.25rem; box-shadow: 0 6px 18px rgba(15,23,42,0.06); }
</style>
{% endblock %}
{% block content %}
<div class="layout">
    {% include 'staff/_sidebar.html.twig' %}

    <div class="flex-1">
        <section class="card">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-[var(--navy)]">Services</h1>
              <p class="text-sm text-gray-600">Browse all services below. Add your own using the button on the right.</p>
            </div>

            <a href="{{ path('staff_services_new') }}"
               class="px-3 py-2 bg-[var(--gold)] text-[var(--navy)] font-semibold rounded-lg shadow hover:bg-yellow-400 transition">
              Add Service
            </a>
          </div>

          <div class="bg-[#f8f9fc] rounded-xl border border-gray-200 p-4 overflow-x-auto">
            <table id="servicesTable" class="display min-w-full text-sm text-gray-800">
              <thead class="bg-[var(--gold)] text-[var(--navy)] uppercase font-semibold tracking-wider">
                <tr>
                  <th class="px-5 py-3 text-left">Name</th>
                  <th class="px-5 py-3 text-left">Description</th>
                  <th class="px-5 py-3 text-left">Price</th>
                  <th class="px-5 py-3 text-center">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                {% for service in services %}
                  <tr class="hover:bg-yellow-50 transition duration-150">
                    <td class="px-5 py-3 font-semibold text-[var(--gold)]">{{ service.name }}</td>
                    <td class="px-5 py-3 text-[var(--navy)]">{{ service.description }}</td>
                    <td class="px-5 py-3">₱{{ service.price }}</td>
                    <td class="px-5 py-3 text-center">
                      <div class="flex items-center justify-center gap-2">
                      <a href="{{ path('staff_services_show', {'id': service.id}) }}"
                         class="inline-block px-3 py-1 bg-blue-600 text-white rounded-md text-xs font-semibold hover:bg-blue-700 transition">
                        View
                      </a>
                      {# Allow staff to manage any service except those owned by admins #}
                      {% set canManage = not (service.owner is not null and ('ROLE_ADMIN' in service.owner.roles)) %}
                      {% if canManage %}
                        <a href="{{ path('staff_services_edit', {'id': service.id}) }}"
                           class="inline-block px-3 py-1 bg-yellow-400 text-[var(--navy)] rounded-md text-xs font-semibold hover:bg-yellow-300 transition">
                          Edit
                        </a>
                        <form method="post" action="{{ path('staff_services_delete', {'id': service.id}) }}" class="inline js-confirm-delete" data-item-name="{{ service.name }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('delete-service-' ~ service.id) }}">
                          <button type="submit"
                                  class="px-3 py-1 bg-red-600 text-white rounded-md text-xs font-semibold hover:bg-red-700 transition">
                            Delete
                          </button>
                        </form>
                      {% endif %}
                      </div>
                    </td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="4" class="px-5 py-6 text-center text-gray-400 italic">No services found</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </section>
    </div>
</div>
{% endblock %}

{% block scripts %}
  {{ parent() }}
  <div id="confirmModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black bg-opacity-50">
    <div class="bg-white rounded-lg p-6 w-11/12 max-w-md mx-auto shadow-lg">
      <h3 id="confirmModalTitle" class="text-lg font-semibold text-gray-800">Confirm delete</h3>
      <p id="confirmModalMessage" class="mt-2 text-sm text-gray-700">Are you sure you want to delete this item?</p>
      <div class="mt-4 flex justify-end gap-2">
        <button id="confirmCancel" class="px-3 py-1 bg-gray-200 rounded text-sm">Cancel</button>
        <button id="confirmOk" class="px-3 py-1 bg-red-600 text-white rounded text-sm">Delete</button>
      </div>
    </div>
  </div>

  <script>
    (function(){
      let modal = document.getElementById('confirmModal');
      let msg = document.getElementById('confirmModalMessage');
      let btnOk = document.getElementById('confirmOk');
      let btnCancel = document.getElementById('confirmCancel');
      let currentForm = null;

      function showModal(text){
        msg.textContent = text;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
      function hideModal(){
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        currentForm = null;
      }

      document.querySelectorAll('.js-confirm-delete').forEach(function(form){
        form.addEventListener('submit', function(e){
          e.preventDefault();
          currentForm = form;
          const name = form.dataset.itemName || 'this item';
          showModal('Are you sure you want to delete "' + name + '"? This action cannot be undone.');
        });
      });

      btnCancel.addEventListener('click', function(){ hideModal(); });
      btnOk.addEventListener('click', function(){
        if(currentForm){ currentForm.submit(); }
      });

      // close on Escape
      document.addEventListener('keydown', function(e){ if(e.key === 'Escape'){ hideModal(); } });

      // click outside to close
      modal.addEventListener('click', function(e){ if(e.target === modal){ hideModal(); } });
    })();
  </script>
{% endblock %}
