{# templates/base.twig #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}LuxePaws{% endblock %}</title>
  <style>
    :root {
      --navy:#1C1F3A;
      --gold:#D4AF37;
      --cream:#F9F6F0;
      --char:#333333;
      --radius:14px;
      --container:1100px;
      font-family: "Poppins", system-ui, -apple-system, "Segoe UI", Roboto, Arial;
    }
    body {margin:0;background:var(--cream);color:var(--char);}
    .wrap {max-width:var(--container);margin:0 auto;padding:28px}
    header {display:flex;align-items:center;justify-content:space-between;padding:12px 0}
    nav a {margin-left:18px;color:var(--navy);text-decoration:none;font-size:15px}
    .btn {background:var(--gold);color:var(--navy);padding:10px 16px;border-radius:12px;text-decoration:none;font-weight:600}
    footer {margin-top:30px;padding:18px 0;color:var(--char);font-size:14px;text-align:center;border-top:1px solid rgba(0,0,0,0.1)}
    .muted {color:rgba(51,51,51,0.7)}
    h1,h2,h3 {font-family:"Playfair Display", serif;color:var(--navy)}
    section {margin-top:40px}
  </style>
  {% block styles %}{% endblock %}
</head>
<body>
  <div class="wrap">
    <header>
      {% block header %}
      <div style="font-weight:700;color:var(--navy);font-size:20px">LuxePaws</div>
      <nav>
        <a href="#services">Services</a>
        <a href="#pricing">Pricing</a>
        <a href="#reviews">Reviews</a>
        <a href="#contact">Contact</a>
        <a class="btn" href="{{ book_url|default('#book') }}">Book Appointment</a>
      </nav>
      {% endblock %}
    </header>

    <main>
      {% block content %}{% endblock %}
    </main>

    <footer>
      {% block footer %}
      © {{ "now"|date("Y") }} LuxePaws. Premium Pet Grooming at Your Fingertips.
      {% endblock %}
    </footer>
  </div>
  {% block scripts %}{% endblock %}
</body>
</html>
