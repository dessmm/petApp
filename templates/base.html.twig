{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}LuxePaws{% endblock %}</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    :root {
      --navy: #1C1F3A;
      --gold: #D4AF37;
      --cream: #F9F6F0;
      --char: #333333;
    }

    body {
      margin: 0;
      background-color: var(--cream);
      color: var(--char);
      font-family: "Poppins", system-ui, -apple-system, "Segoe UI", Roboto, Arial;
    }

    h1, h2, h3 {
      font-family: "Playfair Display", serif;
      color: var(--navy);
    }
  </style>

  {% block styles %}{% endblock %}
</head>
<body class="min-h-screen flex flex-col">

  <header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="{{ path('app_home') }}" class="text-xl font-bold text-[var(--navy)] hover:text-[var(--gold)] transition">
        LuxePaws
      </a>

      <nav class="flex items-center space-x-5 text-[var(--navy)] font-medium text-[15px]">
        <a href="{{ path('app_home') }}" class="hover:text-[var(--gold)] transition flex items-center h-full">
          Home
        </a>
        <a href="{{ path('app_services_index') }}" class="hover:text-[var(--gold)] transition flex items-center h-full">
          Services
        </a>
        <a href="{{ path('app_features') }}" class="hover:text-[var(--gold)] transition flex items-center h-full">
          Features
        </a>
        <a href="{{ path('app_about') }}" class="hover:text-[var(--gold)] transition flex items-center h-full">
          About
        </a>
        </a>
        <a href="{{ path('app_contact_public') }}" class="hover:text-[var(--gold)] transition flex items-center h-full">
          Contact
        </a>

        {% set hidden_routes = ['app_appointment_index','app_appointment_new', 'app_appointment_edit', 'app_appointment_show'] %}
        {% if app.request.attributes.get('_route') not in hidden_routes %}
          <a href="{{ path('app_appointment_new') }}"
             class="px-4 py-1.5 bg-[var(--gold)] text-[var(--navy)] rounded-lg shadow hover:bg-yellow-400 transition text-sm font-semibold flex items-center">
             Book Now
          </a>
        {% endif %}
      </nav>
    </div>
  </header>

  <main class="flex-1 px-4 sm:px-6 md:px-8 py-6">
    {% block content %}{% endblock %}
  </main> 

  <footer class="bg-white border-t mt-8">
    <div class="max-w-7xl mx-auto px-4 py-4 text-center text-sm text-gray-600">
      {% block footer %}
        © {{ "now"|date("Y") }} <span class="font-semibold text-[var(--navy)]">LuxePaws</span>. All rights reserved.
      {% endblock %}
    </div>
  </footer>

  {% block scripts %}{% endblock %}
</body>
</html>
